<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Dash Cam</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_dashcam-offload._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Dash Cam records video through the camera while you drive.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Dash Cam finds your Mac on the home network to offload footage and free up space on this iPhone.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Always access keeps the GPS fix locked for speed and route logging while the phone is dash-mounted.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Dash Cam records your speed, heading, and route alongside video for evidence-quality footage.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Dash Cam records cabin audio with your video. You can mute it in Settings.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Dash Cam saves exported clips to your Photos library.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
